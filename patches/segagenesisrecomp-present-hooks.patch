diff --git a/runner/host_present_hooks.h b/runner/host_present_hooks.h
new file mode 100644
index 0000000..c4201ca
--- /dev/null
+++ b/runner/host_present_hooks.h
@@ -0,0 +1,25 @@
+#pragma once
+/* Optional host presentation hooks (OpenGL presenter, side panel, shaders).
+ * A game adds them from its own sources; with no hooks set the runner keeps its
+ * SDL_Renderer path unchanged. */
+#include <SDL.h>
+#include <stdint.h>
+
+typedef struct GenesisPresentHooks {
+    /* Before SDL_CreateWindow: may add window flags and SDL hints. */
+    void (*pre_window)(Uint32 *window_flags);
+    /* After the window and the SDL renderer exist. */
+    void (*window_created)(SDL_Window *window, SDL_Renderer *renderer);
+    /* Draw this frame. Return 1 when the hook drew it (then swap() is used
+     * instead of SDL_RenderPresent). Pixels are ARGB8888, top row first. */
+    int  (*present)(SDL_Window *window, const uint32_t *pixels, int stride,
+                    int width, int height);
+    void (*swap)(SDL_Window *window);
+    /* Every SDL event first. Return 1 to swallow it and open the menu,
+     * 2 to swallow it only, 0 to let the runner handle it. */
+    int  (*event)(const SDL_Event *ev);
+    /* Modal menu (the guest is frozen). Sets *running = 0 to quit. */
+    void (*run_menu)(SDL_Window *window, int *running);
+} GenesisPresentHooks;
+
+extern GenesisPresentHooks g_present_hooks;
