+/* Cartridge I/O hook (Wily Wars recomp patch). */
+typedef struct GenesisCartIo {
+    uint32_t lo, hi;                         /* inclusive 24-bit window   */
+    uint16_t (*read16)(uint32_t even_addr);  /* NULL = hook disabled      */
