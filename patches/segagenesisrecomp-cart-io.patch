 /* ---- 68K bus -------------------------------------------------------------- */
+/* Cartridge I/O hook (Wily Wars recomp patch): a game adapter can claim a
+ * small address window for an on-cart device (serial EEPROM etc.). The
+ * device sees every 68K access in [lo, hi] before SRAM/ROM decoding. */
+GenesisCartIo g_cart_io;
+static int cart_io_hit(uint32_t a)
+{
+    return g_cart_io.read16 && a >= g_cart_io.lo && a <= g_cart_io.hi;
+}
+
 uint16_t gbus_read16(GenesisBus *b, uint32_t a)
 {
     a &= 0xFFFFFFu;
+    if (cart_io_hit(a)) return g_cart_io.read16(a & ~1u);
     if (sram_hit(b, a)) {                                            /* SRAM    */
         uint32_t o = a - b->sram_base;
         return (uint16_t)((b->sram[o] << 8) | b->sram[(o + 1u) % b->sram_size]);
@@ -392,6 +402,11 @@ uint8_t gbus_peek8(const GenesisBus *b, uint32_t a)
 void gbus_write16(GenesisBus *b, uint32_t a, uint16_t v)
