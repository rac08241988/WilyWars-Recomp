+    if (cart_io_hit(a)) {
+        if (g_cart_io.write8) { g_cart_io.write8(a & ~1u, (uint8_t)(v >> 8));
+                                g_cart_io.write8(a | 1u, (uint8_t)v); }
+        return;
+    }
     if (a >= 0xFF0000u) {                                            /* RAM     */
         uint16_t o = (uint16_t)(a & 0xFFFFu);
         g_ram[o] = (uint8_t)(v >> 8); g_ram[(uint16_t)(o + 1)] = (uint8_t)v;
@@ -453,6 +468,10 @@ uint8_t gbus_read8(GenesisBus *b, uint32_t a)
      * gbus_write8). */
     if (a >= 0xA00000u && a < 0xA10000u && (a & 0xFFFFu) < 0x2000u)
         return b->z80_ram[a & 0x1FFFu];
+    if (cart_io_hit(a & 0xFFFFFFu)) {
+        uint16_t w = g_cart_io.read16((a & 0xFFFFFFu) & ~1u);
+        return (a & 1) ? (uint8_t)w : (uint8_t)(w >> 8);
+    }
     if (sram_hit(b, a & 0xFFFFFFu))                       /* SRAM: exact byte  */
         return b->sram[(a & 0xFFFFFFu) - b->sram_base];
     uint16_t w = gbus_read16(b, a & ~1u);
@@ -462,6 +481,7 @@ uint8_t gbus_read8(GenesisBus *b, uint32_t a)
